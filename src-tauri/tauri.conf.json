{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether IDE",
  "version": "0.3.0",
  "identifier": "dev.aether.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://open-vsx.org https://raw.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https://open-vsx.org https://raw.githubusercontent.com https://github.com https://api.github.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Pixel-Alquimia-Studios/Aether-IDE/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OTE5QTExNDkwMzk5MTkKUldRWm1RTkpFWnFSYVQ1WWo2TnFzT0dEbzlMR251Z3lGUjEzcmsycUo1K0RncWlsNjIrd2xqSysK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Spanish", "English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}